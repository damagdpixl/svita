-- System color palette for garment attributes. `key` is the canonical English
-- color name used by the outfit engine as the color identifier; `name_uk` is
-- the display name; `hex` is the sRGB value the engine's color-harmony math
-- consumes. Seeded in taxonomy_seed.sq.
CREATE TABLE colors (
    id INTEGER NOT NULL PRIMARY KEY,
    key TEXT NOT NULL UNIQUE,
    name_uk TEXT NOT NULL,
    hex TEXT NOT NULL
);

selectAllColors:
SELECT * FROM colors ORDER BY id;

selectColorByKey:
SELECT * FROM colors WHERE key = ?;

-- Backup restore (REPLACE import re-seeds the palette after a wipe).
insertColor:
INSERT INTO colors (id, key, name_uk, hex) VALUES (?, ?, ?, ?);

deleteAllColors:
DELETE FROM colors;
