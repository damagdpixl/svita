CREATE TABLE photos (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    path TEXT NOT NULL,
    position INTEGER NOT NULL
);

CREATE INDEX idx_photos_item_id ON photos(item_id);

insertPhoto:
INSERT INTO photos (item_id, path, position) VALUES (?, ?, ?);

selectAllPhotos:
SELECT * FROM photos ORDER BY item_id, position;

selectPhotosByItem:
SELECT * FROM photos WHERE item_id = ? ORDER BY position, id;

deletePhotosByItem:
DELETE FROM photos WHERE item_id = ?;

-- Backup restore: insert with the exported id (see restoreItem).
restorePhoto:
INSERT INTO photos (id, item_id, path, position) VALUES (?, ?, ?, ?);

deleteAllPhotos:
DELETE FROM photos;
