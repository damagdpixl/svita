CREATE TABLE subtypes (
    id INTEGER NOT NULL PRIMARY KEY,
    category_id INTEGER NOT NULL REFERENCES categories(id),
    key TEXT NOT NULL UNIQUE,
    name_en TEXT NOT NULL,
    name_uk TEXT NOT NULL,
    thermal_class TEXT NOT NULL
);

CREATE INDEX idx_subtypes_category_id ON subtypes(category_id);

insertSubtype:
INSERT INTO subtypes (id, category_id, key, name_en, name_uk, thermal_class)
VALUES (?, ?, ?, ?, ?, ?);

selectSubtypeById:
SELECT * FROM subtypes WHERE id = ?;

selectSubtypeByKey:
SELECT * FROM subtypes WHERE key = ?;

selectAllSubtypes:
SELECT * FROM subtypes ORDER BY id;

selectSubtypesByCategory:
SELECT * FROM subtypes WHERE category_id = :categoryId ORDER BY id;

selectSubtypesBySection:
SELECT subtypes.* FROM subtypes
JOIN categories ON subtypes.category_id = categories.id
WHERE categories.section = :section
ORDER BY subtypes.id;

-- Backup restore (REPLACE import re-seeds the taxonomy after a wipe).
deleteAllSubtypes:
DELETE FROM subtypes;
