CREATE TABLE tags (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

insertTag:
INSERT INTO tags (name) VALUES (?);

selectLastInsertedTagId:
SELECT last_insert_rowid();

selectTagByName:
SELECT * FROM tags WHERE name = ?;

selectAllTags:
SELECT * FROM tags ORDER BY name;

deleteTag:
DELETE FROM tags WHERE id = ?;

CREATE TABLE item_tags (
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    tag_id INTEGER NOT NULL REFERENCES tags(id) ON DELETE CASCADE,
    PRIMARY KEY (item_id, tag_id)
);

CREATE INDEX idx_item_tags_tag_id ON item_tags(tag_id);

insertItemTag:
INSERT INTO item_tags (item_id, tag_id) VALUES (?, ?);

selectAllItemTags:
SELECT * FROM item_tags ORDER BY item_id, tag_id;

-- Tags of one item, resolved to the tag rows themselves.
selectTagsByItem:
SELECT tags.* FROM tags JOIN item_tags ON tags.id = item_tags.tag_id
WHERE item_tags.item_id = ? ORDER BY tags.id;

deleteItemTagsByItem:
DELETE FROM item_tags WHERE item_id = ?;

-- Backup restore: insert with the exported id (see restoreItem).
restoreTag:
INSERT INTO tags (id, name) VALUES (?, ?);

deleteAllTags:
DELETE FROM tags;

deleteAllItemTags:
DELETE FROM item_tags;
