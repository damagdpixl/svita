CREATE TABLE packing_lists (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    date_from TEXT,
    date_to TEXT,
    created_at TEXT NOT NULL
);

insertPackingList:
INSERT INTO packing_lists (title, date_from, date_to, created_at) VALUES (?, ?, ?, ?);

selectLastInsertedPackingListId:
SELECT last_insert_rowid();

selectPackingListById:
SELECT * FROM packing_lists WHERE id = ?;

updatePackingList:
UPDATE packing_lists SET title = ?, date_from = ?, date_to = ? WHERE id = ?;

deletePackingList:
DELETE FROM packing_lists WHERE id = ?;

selectAllPackingLists:
SELECT * FROM packing_lists ORDER BY id;

CREATE TABLE packing_items (
    packing_list_id INTEGER NOT NULL REFERENCES packing_lists(id) ON DELETE CASCADE,
    item_id INTEGER NOT NULL REFERENCES items(id) ON DELETE CASCADE,
    packed INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (packing_list_id, item_id)
);

CREATE INDEX idx_packing_items_item_id ON packing_items(item_id);

insertPackingItem:
INSERT INTO packing_items (packing_list_id, item_id, packed) VALUES (?, ?, ?);

selectAllPackingItems:
SELECT * FROM packing_items ORDER BY packing_list_id, item_id;

selectPackingItemsByList:
SELECT * FROM packing_items WHERE packing_list_id = ? ORDER BY item_id;

updatePacked:
UPDATE packing_items SET packed = ? WHERE packing_list_id = ? AND item_id = ?;

deletePackingItem:
DELETE FROM packing_items WHERE packing_list_id = ? AND item_id = ?;
