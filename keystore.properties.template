# Svita release signing — template.
# Copy to `keystore.properties` (repo root) and fill in real values.
#   cp keystore.properties.template keystore.properties
# NEVER commit `keystore.properties` or the keystore file itself —
# both are gitignored, and the keystore must live OUTSIDE the repo
# (with an offline backup). Full instructions: docs/release_v0.1.0.md
#
# `storeFile` may be an absolute path, or a path relative to this repo's root.
storeFile=/absolute/path/to/svita-release.jks
storePassword=REPLACE_WITH_STRONG_PASSWORD
keyAlias=svita-release
# For a PKCS12 keystore this is the same as storePassword.
keyPassword=REPLACE_WITH_STRONG_PASSWORD
